<%- include('_head') %>

<h1 class="page-title">ชั้นหนังสือ <span class="muted"><%= total %> เรื่อง</span></h1>

<form class="searchbar" method="get" action="/" role="search">
  <input type="search" name="q" value="<%= q %>" placeholder="ค้นหาชื่อเรื่อง หรือแนว"
         aria-label="ค้นหานิยาย" autocomplete="off">
  <button class="btn" type="submit">ค้นหา</button>
  <% if (q) { %><a class="btn" href="/">ล้าง</a><% } %>
</form>

<% if (q) { %>
  <p class="search-note">
    <% if (novels.length) { %>
      พบ <strong><%= novels.length %></strong> เรื่อง จากคำว่า “<%= q %>”
    <% } else { %>
      ไม่พบนิยายที่ตรงกับ “<%= q %>”
    <% } %>
  </p>
<% } else if (!total) { %>
  <section class="empty">
    <p>ยังไม่มีนิยายในโฟลเดอร์ <code>data/</code></p>
  </section>
<% } %>

<ul class="shelf">
<% for (const n of novels) { %>
  <li class="card">
    <div class="card-main">
      <a class="card-title" href="/novel/<%= enc(n.name) %>"><%= n.name %></a>
      <div class="card-meta">
        <span><%= n.count.toLocaleString('th-TH') %> ตอน</span>
        <% if (n.profile.status === 'completed') { %><span class="tag tag-done">จบแล้ว</span><% } %>
        <% if (n.profile.status === 'ongoing') { %><span class="tag">ยังไม่จบ</span><% } %>
        <% for (const g of (n.profile.genres || [])) { %><span class="tag"><%= g %></span><% } %>
      </div>
      <% if (n.resume) { %>
        <div class="card-resume">อ่านค้างไว้ตอนที่ <%= n.resume.position %></div>
      <% } %>
    </div>
    <div class="card-actions">
      <% if (n.resume) { %>
        <a class="btn btn-primary" href="/read/<%= enc(n.name) %>">อ่านต่อ →</a>
      <% } else if (n.firstRef) { %>
        <a class="btn btn-primary" href="/read/<%= enc(n.name) %>/<%= enc(n.firstRef) %>">เริ่มอ่าน →</a>
      <% } %>
      <a class="btn" href="/novel/<%= enc(n.name) %>">สารบัญ</a>
    </div>
  </li>
<% } %>
</ul>

<%- include('_foot') %>
