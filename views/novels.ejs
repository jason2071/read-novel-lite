<%- include('_head') %>

<h1 class="page-title">ชั้นหนังสือ <span class="muted"><%= total %> เรื่อง</span></h1>

<form class="searchbar" method="get" action="/" role="search">
  <input type="search" name="q" value="<%= q %>" placeholder="ค้นหาชื่อเรื่อง หรือแนว"
         aria-label="ค้นหานิยาย" autocomplete="off">
  <button class="btn" type="submit">ค้นหา</button>
  <% if (q) { %><a class="btn" href="/">ล้าง</a><% } %>
</form>

<% if (q) { %>
  <p class="search-note">
    <% if (novels.length) { %>
      พบ <strong><%= novels.length %></strong> เรื่อง จากคำว่า “<%= q %>”
    <% } else { %>
      ไม่พบนิยายที่ตรงกับ “<%= q %>”
    <% } %>
  </p>
<% } else if (!total) { %>
  <section class="empty">
    <p>ยังไม่มีนิยายในโฟลเดอร์ <code>data/</code></p>
  </section>
<% } %>

<ul class="shelf">
<% for (const n of novels) { %>
  <li class="card<%= n.resume ? ' card-reading' : '' %>">
    <div class="card-main">
      <a class="card-title" href="/novel/<%= enc(n.name) %>"><%= n.name %></a>
      <div class="card-meta">
        <span><%= n.count.toLocaleString('th-TH') %> ตอน</span>
      </div>
    </div>
    <% if (n.resume) { %>
      <div class="card-resume">อ่านถึง <strong>ตอนที่ <%= n.resume.position %></strong></div>
    <% } %>
    <%# Reading opens in its own tab, so the shelf stays where it was — browsing
        and reading are separate activities here. rel=noopener because target
        _blank otherwise hands the new page a handle on this one. %>
    <div class="card-actions">
      <% if (n.resume) { %>
        <a class="btn btn-primary" href="/read/<%= enc(n.name) %>" target="_blank" rel="noopener">อ่านต่อ</a>
      <% } else if (n.firstRef) { %>
        <a class="btn btn-primary" href="/read/<%= enc(n.name) %>/<%= enc(n.firstRef) %>" target="_blank" rel="noopener">เริ่มอ่าน</a>
      <% } %>
      <a class="card-toc" href="/novel/<%= enc(n.name) %>">สารบัญ</a>
    </div>
  </li>
<% } %>
</ul>

<%- include('_foot') %>
