<%- include('_head') %>

<h1 class="page-title">ชั้นหนังสือ <span class="muted"><%= total %> เรื่อง</span></h1>

<form class="searchbar" method="get" action="/" role="search">
  <input type="hidden" name="sort" value="<%= sort %>">
  <input type="search" name="q" value="<%= q %>" placeholder="ค้นหาชื่อเรื่อง หรือแนว"
         aria-label="ค้นหานิยาย" autocomplete="off">
  <button class="btn" type="submit">ค้นหา</button>
  <% if (q) { %><a class="btn" href="/?sort=<%= enc(sort) %>">ล้าง</a><% } %>
</form>

<%
  // One place builds a catalogue link, so the page number, search term, and
  // selected order never drift apart. Continue reading is outside this pager.
  const pageHref = (p) => `/?page=${p}&sort=${enc(sort)}` + (q ? `&q=${enc(q)}` : '');
%>

<% if (q) { %>
  <p class="search-note">
    <% if (matchCount) { %>
      พบ <strong><%= matchCount %></strong> เรื่อง จากคำว่า “<%= q %>”
    <% } else { %>
      ไม่พบนิยายที่ตรงกับ “<%= q %>”
    <% } %>
  </p>
<% } else if (!total) { %>
  <section class="empty">
    <p>ยังไม่มีนิยายในโฟลเดอร์ <code>data/</code></p>
  </section>
<% } %>

<% if (continueNovels.length) { %>
  <section class="continue-section" aria-labelledby="continue-heading">
    <div class="shelf-section-head">
      <h2 id="continue-heading">อ่านต่อ</h2>
      <span><%= continueCount %> เรื่อง</span>
      <a class="section-link" href="/continue">ดูทั้งหมด</a>
    </div>
    <div class="continue-list">
    <% for (const n of continueNovels) { %>
      <article class="continue-card">
        <a class="continue-title" href="/novel/<%= enc(n.name) %>" title="<%= n.name %>"><%= n.name %></a>
        <p>อ่านถึง <strong>ตอนที่ <%= n.resume.position %></strong><span><%= n.resume.position.toLocaleString('th-TH') %> / <%= n.count.toLocaleString('th-TH') %></span></p>
        <a class="book-action" href="/read/<%= enc(n.name) %>" target="_blank" rel="noopener">อ่านต่อ</a>
      </article>
    <% } %>
    </div>
  </section>
<% } %>

<% if (novels.length) { %>
  <section class="catalog-section" aria-labelledby="catalog-heading">
    <div class="shelf-section-head">
      <h2 id="catalog-heading"><%= q ? 'ผลการค้นหา' : 'นิยายทั้งหมด' %></h2>
      <span><%= q ? `${matchCount} เรื่อง` : `${total} เรื่อง` %></span>
      <form class="catalog-order" method="get" action="/">
        <% if (q) { %><input type="hidden" name="q" value="<%= q %>"><% } %>
        <input type="hidden" name="page" value="1">
        <label>
          เรียง
          <select name="sort" onchange="this.form.submit()" aria-label="เรียงลำดับนิยายทั้งหมด">
            <option value="name"<%= sort === 'name' ? ' selected' : '' %>>ชื่อเรื่อง ก-ฮ</option>
            <option value="chapters-desc"<%= sort === 'chapters-desc' ? ' selected' : '' %>>ตอนมากสุด</option>
            <option value="chapters-asc"<%= sort === 'chapters-asc' ? ' selected' : '' %>>ตอนน้อยสุด</option>
            <option value="updated-desc"<%= sort === 'updated-desc' ? ' selected' : '' %>>อัปเดตล่าสุด</option>
            <option value="added-desc"<%= sort === 'added-desc' ? ' selected' : '' %>>เพิ่มล่าสุด</option>
          </select>
        </label>
        <button hidden type="submit">เรียงลำดับ</button>
      </form>
    </div>
    <ul class="book-list">
  <% for (const n of novels) { %>
      <li class="book-row">
        <div class="book-info">
          <a class="book-title" href="/novel/<%= enc(n.name) %>" title="<%= n.name %>"><%= n.name %></a>
          <div class="book-meta">
            <span><%= n.count.toLocaleString('th-TH') %> ตอน</span>
          </div>
        </div>
        <%# The title goes to the table of contents. The only row action opens
            the next chapter, which keeps the shelf quick to scan. %>
        <% if (n.resume || n.firstRef) { %>
          <% if (n.resume) { %>
            <a class="book-action" href="/read/<%= enc(n.name) %>" target="_blank" rel="noopener">อ่านต่อ</a>
          <% } else { %>
            <a class="book-action" href="/read/<%= enc(n.name) %>/<%= enc(n.firstRef) %>" target="_blank" rel="noopener">เริ่มอ่าน</a>
          <% } %>
        <% } %>
      </li>
  <% } %>
    </ul>

<%# Same windowed pager as the table of contents — the CSS classes already exist. %>
<% if (pages > 1) { %>
<%
  const from = Math.max(1, pageNo - 3);
  const to = Math.min(pages, pageNo + 3);
%>
    <nav class="pager">
      <% if (pageNo > 1) { %><a class="btn btn-sm" href="<%= pageHref(pageNo - 1) %>">← ก่อนหน้า</a><% } %>
      <% if (from > 1) { %>
        <a class="chip" href="<%= pageHref(1) %>">1</a>
        <% if (from > 2) { %><span class="muted">…</span><% } %>
      <% } %>
      <% for (let p = from; p <= to; p++) { %>
        <a class="chip<%= p === pageNo ? ' active' : '' %>" href="<%= pageHref(p) %>"><%= p %></a>
      <% } %>
      <% if (to < pages) { %>
        <% if (to < pages - 1) { %><span class="muted">…</span><% } %>
        <a class="chip" href="<%= pageHref(pages) %>"><%= pages %></a>
      <% } %>
      <% if (pageNo < pages) { %><a class="btn btn-sm" href="<%= pageHref(pageNo + 1) %>">ถัดไป →</a><% } %>
    </nav>
<% } %>
  </section>
<% } %>

<%- include('_foot') %>
