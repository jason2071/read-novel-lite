<%- include('_head') %>

<h1 class="page-title">ชั้นหนังสือ <span class="muted"><%= total %> เรื่อง</span></h1>

<form class="searchbar" method="get" action="/" role="search">
  <input type="search" name="q" value="<%= q %>" placeholder="ค้นหาชื่อเรื่อง หรือแนว"
         aria-label="ค้นหานิยาย" autocomplete="off">
  <button class="btn" type="submit">ค้นหา</button>
  <% if (q) { %><a class="btn" href="/">ล้าง</a><% } %>
</form>

<% if (q) { %>
  <p class="search-note">
    <% if (novels.length) { %>
      พบ <strong><%= novels.length %></strong> เรื่อง จากคำว่า “<%= q %>”
    <% } else { %>
      ไม่พบนิยายที่ตรงกับ “<%= q %>”
    <% } %>
  </p>
<% } else if (!total) { %>
  <section class="empty">
    <p>ยังไม่มีนิยายในโฟลเดอร์ <code>data/</code></p>
  </section>
<% } %>

<% if (continueNovels.length) { %>
  <section class="continue-section" aria-labelledby="continue-heading">
    <div class="shelf-section-head">
      <h2 id="continue-heading">อ่านต่อ</h2>
      <span><%= continueCount %> เรื่อง</span>
      <a class="section-link" href="/continue">ดูทั้งหมด</a>
    </div>
    <div class="continue-list">
    <% for (const n of continueNovels) { %>
      <article class="continue-card">
        <a class="continue-title" href="/novel/<%= enc(n.name) %>" title="<%= n.name %>"><%= n.name %></a>
        <p>อ่านถึง <strong>ตอนที่ <%= n.resume.position %></strong><span><%= n.resume.position.toLocaleString('th-TH') %> / <%= n.count.toLocaleString('th-TH') %></span></p>
        <a class="book-action" href="/read/<%= enc(n.name) %>" target="_blank" rel="noopener">อ่านต่อ</a>
      </article>
    <% } %>
    </div>
  </section>
<% } %>

<% if (novels.length) { %>
  <section class="catalog-section" aria-labelledby="catalog-heading">
    <div class="shelf-section-head">
      <h2 id="catalog-heading"><%= q ? 'ผลการค้นหา' : 'นิยายทั้งหมด' %></h2>
      <span><%= q ? `${novels.length} เรื่อง` : `${total} เรื่อง` %></span>
    </div>
    <ul class="book-list">
  <% for (const n of novels) { %>
      <li class="book-row">
        <div class="book-info">
          <a class="book-title" href="/novel/<%= enc(n.name) %>" title="<%= n.name %>"><%= n.name %></a>
          <div class="book-meta">
            <span><%= n.count.toLocaleString('th-TH') %> ตอน</span>
          </div>
        </div>
        <%# The title goes to the table of contents. The only row action opens
            the next chapter, which keeps the shelf quick to scan. %>
        <% if (n.resume || n.firstRef) { %>
          <% if (n.resume) { %>
            <a class="book-action" href="/read/<%= enc(n.name) %>" target="_blank" rel="noopener">อ่านต่อ</a>
          <% } else { %>
            <a class="book-action" href="/read/<%= enc(n.name) %>/<%= enc(n.firstRef) %>" target="_blank" rel="noopener">เริ่มอ่าน</a>
          <% } %>
        <% } %>
      </li>
  <% } %>
    </ul>
  </section>
<% } %>

<%- include('_foot') %>
